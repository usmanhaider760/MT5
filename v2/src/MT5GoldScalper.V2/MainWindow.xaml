<Window x:Class="TradingDecisionSystem.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:MT5GoldScalper.V2.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Trading Decision System"
        Width="1440"
        Height="900"
        MinWidth="1100"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <!-- ═══════════════════════════════════════════════════════════
         RESOURCE DICTIONARY — dark theme (default)
         Switching theme = reassign these keys at runtime in code-behind
         ════════════════════════════════════════════════════════════ -->
    <Window.Resources>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <conv:PercentageToValueConverter x:Key="PercentageToValueConverter"/>
        <conv:PercentageToBrushConverter x:Key="PercentageToBrushConverter"/>
        <conv:SourceToBrushConverter x:Key="SourceToBrushConverter"/>

        <!-- ── Dark theme colours ── -->
        <SolidColorBrush x:Key="Bg0"         Color="#0E0E15"/>
        <SolidColorBrush x:Key="Bg1"         Color="#13131E"/>
        <SolidColorBrush x:Key="Bg2"         Color="#15151F"/>
        <SolidColorBrush x:Key="Bg3"         Color="#1A1A2C"/>
        <SolidColorBrush x:Key="Bd"          Color="#2E3055"/>
        <SolidColorBrush x:Key="T1"          Color="#DDE0F0"/>
        <SolidColorBrush x:Key="T2"          Color="#8088C0"/>
        <SolidColorBrush x:Key="T3"          Color="#5560A0"/>
        <SolidColorBrush x:Key="T4"          Color="#3A3F70"/>

        <!-- ── Semantic colours ── -->
        <SolidColorBrush x:Key="ColGreen"    Color="#3DDD80"/>
        <SolidColorBrush x:Key="ColYellow"   Color="#F0B030"/>
        <SolidColorBrush x:Key="ColRed"      Color="#F05555"/>

        <!-- ── Verdict backgrounds / borders ── -->
        <SolidColorBrush x:Key="VerdictGreenBg"  Color="#091A10"/>
        <SolidColorBrush x:Key="VerdictGreenBd"  Color="#1A5535"/>
        <SolidColorBrush x:Key="VerdictYellowBg" Color="#251C08"/>
        <SolidColorBrush x:Key="VerdictYellowBd" Color="#553E10"/>
        <SolidColorBrush x:Key="VerdictRedBg"    Color="#250A0A"/>
        <SolidColorBrush x:Key="VerdictRedBd"    Color="#551A1A"/>

        <!-- ── Source tag colours ── -->
        <SolidColorBrush x:Key="TagAutoBg"  Color="#0A1E28"/>
        <SolidColorBrush x:Key="TagAutoFg"  Color="#3090C0"/>
        <SolidColorBrush x:Key="TagAutoBd"  Color="#1A4060"/>
        <SolidColorBrush x:Key="TagSemiBg"  Color="#1B122A"/>
        <SolidColorBrush x:Key="TagSemiFg"  Color="#A68CFF"/>
        <SolidColorBrush x:Key="TagSemiBd"  Color="#4D3D7A"/>
        <SolidColorBrush x:Key="TagApiBg"   Color="#061F24"/>
        <SolidColorBrush x:Key="TagApiFg"   Color="#42C7D9"/>
        <SolidColorBrush x:Key="TagApiBd"   Color="#1E5964"/>
        <SolidColorBrush x:Key="TagManBg"   Color="#171B24"/>
        <SolidColorBrush x:Key="TagManFg"   Color="#AEB8CC"/>
        <SolidColorBrush x:Key="TagManBd"   Color="#3E485A"/>
        <SolidColorBrush x:Key="TagCfgBg"   Color="#14182D"/>
        <SolidColorBrush x:Key="TagCfgFg"   Color="#8FA3FF"/>
        <SolidColorBrush x:Key="TagCfgBd"   Color="#3D4B86"/>

        <!-- ══════════════════════════════════════
             CONVERTERS  (implement in code-behind)
             SeverityToBrushConverter  : "Good"|"Watch"|"Bad" → Brush
             NullToVisibilityConverter : null → Collapsed, else Visible
             ════════════════════════════════════ -->

        <!-- ── Base text style ── -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground"  Value="{DynamicResource T1}"/>
            <Setter Property="FontFamily"  Value="Segoe UI"/>
            <Setter Property="FontSize"    Value="12"/>
        </Style>

        <!-- ── Tiny dim label (group headers, column headers) ── -->
        <Style x:Key="S.TinyLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource T3}"/>
            <Setter Property="FontSize"   Value="9"/>
            <Setter Property="Margin"     Value="0,0,0,2"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <!-- ── Muted dim label ── -->
        <Style x:Key="S.DimLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource T4}"/>
            <Setter Property="FontSize"   Value="9"/>
        </Style>

        <!-- ── Section title ── -->
        <Style x:Key="S.SectionTitle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource T2}"/>
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>

        <!-- ── Base button (flat, dark) ── -->
        <Style x:Key="S.FlatBtn" TargetType="Button">
            <Setter Property="Background"         Value="{DynamicResource Bg3}"/>
            <Setter Property="Foreground"         Value="{DynamicResource T2}"/>
            <Setter Property="BorderBrush"        Value="{DynamicResource Bd}"/>
            <Setter Property="BorderThickness"    Value="1"/>
            <Setter Property="Padding"            Value="10,5"/>
            <Setter Property="Cursor"             Value="Hand"/>
            <Setter Property="FontSize"           Value="11"/>
            <Setter Property="FontFamily"         Value="Segoe UI"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg2}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg0}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Toggle button (theme / layout) with Active state ── -->
        <Style x:Key="S.ToggleBtn" TargetType="ToggleButton">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource T3}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="8,3"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="10"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg1}"/>
                                <Setter Property="Foreground" Value="{DynamicResource T1}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg2}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── Action button (BUY/SELL/SKIP) ── -->
        <Style x:Key="S.ActionBtn" TargetType="Button" BasedOn="{StaticResource S.FlatBtn}">
            <Setter Property="MinWidth"    Value="70"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="Padding"     Value="12,6"/>
        </Style>

        <!-- ── ProgressBar dark override ── -->
        <Style x:Key="S.ConfBar" TargetType="ProgressBar">
            <Setter Property="Height"      Value="6"/>
            <Setter Property="Background"  Value="{DynamicResource Bg3}"/>
            <Setter Property="Foreground"  Value="{DynamicResource ColGreen}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="3"
                                Height="{TemplateBinding Height}">
                            <Border x:Name="PART_Track">
                                <Border x:Name="PART_Indicator"
                                        Background="{TemplateBinding Foreground}"
                                        CornerRadius="3"
                                        HorizontalAlignment="Left"/>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── ComboBox / TextBox dark override ── -->
        <Style TargetType="ComboBox">
            <Setter Property="Background"      Value="{DynamicResource Bg3}"/>
            <Setter Property="Foreground"      Value="{DynamicResource T1}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Bd}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="4,3"/>
            <Setter Property="FontSize"        Value="11"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background"      Value="{DynamicResource Bg3}"/>
            <Setter Property="Foreground"      Value="{DynamicResource T1}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource Bd}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="4,3"/>
            <Setter Property="FontSize"        Value="11"/>
            <Setter Property="CaretBrush"      Value="{DynamicResource T1}"/>
        </Style>

        <!-- ── DataGrid dark override ── -->
        <Style TargetType="DataGrid">
            <Setter Property="Background"              Value="{DynamicResource Bg0}"/>
            <Setter Property="Foreground"              Value="{DynamicResource T2}"/>
            <Setter Property="BorderBrush"             Value="{DynamicResource Bd}"/>
            <Setter Property="BorderThickness"         Value="1"/>
            <Setter Property="RowBackground"           Value="{DynamicResource Bg0}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource Bg1}"/>
            <Setter Property="GridLinesVisibility"     Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Bd}"/>
            <Setter Property="VerticalGridLinesBrush"  Value="{DynamicResource Bd}"/>
            <Setter Property="FontSize"                Value="11"/>
            <Setter Property="CanUserResizeRows"       Value="False"/>
            <Setter Property="SelectionMode"           Value="Single"/>
            <Setter Property="SelectionUnit"           Value="FullRow"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"  Value="{DynamicResource Bg3}"/>
            <Setter Property="Foreground"  Value="{DynamicResource T3}"/>
            <Setter Property="FontSize"    Value="10"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Padding"     Value="8,5"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Bd}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{DynamicResource T2}"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Padding"         Value="8,5"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- ── ScrollBar slim override ── -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
        </Style>

    </Window.Resources>

    <!-- ════════════════════════════════════════════════════════════
         ROOT LAYOUT
         ════════════════════════════════════════════════════════════ -->
    <DockPanel LastChildFill="True"
               Background="{DynamicResource Bg0}">

        <!-- ══════════ TOP BAR ══════════ -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource Bg1}"
                BorderBrush="{DynamicResource Bd}"
                BorderThickness="0,0,0,1"
                Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>   <!-- App name -->
                    <ColumnDefinition Width="Auto"/>   <!-- Pair selector -->
                    <ColumnDefinition Width="Auto"/>   <!-- Session pills -->
                    <ColumnDefinition Width="*"/>      <!-- Spacer -->
                    <ColumnDefinition Width="Auto"/>   <!-- Theme toggle -->
                    <ColumnDefinition Width="Auto"/>   <!-- Layout toggle -->
                    <ColumnDefinition Width="Auto"/>   <!-- MT5 status -->
                </Grid.ColumnDefinitions>

                <!-- App name -->
                <TextBlock Grid.Column="0"
                           Text="TRADING DECISION SYSTEM"
                           Foreground="{DynamicResource T3}"
                           FontSize="10"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"/>

                <!-- Pair selector -->
                <ComboBox Grid.Column="1"
                          x:Name="CbPair"
                          ItemsSource="{Binding Pairs}"
                          SelectedItem="{Binding SelectedPair}"
                          MinWidth="130"
                          VerticalAlignment="Center"/>

                <!-- Session pills -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="10,0,0,0">
                    <Border Background="{DynamicResource VerdictGreenBg}"
                            BorderBrush="{DynamicResource VerdictGreenBd}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="9,3">
                        <TextBlock Text="{Binding SessionName}"
                                   Foreground="{DynamicResource ColGreen}"
                                   FontSize="10"/>
                    </Border>
                    <Border Background="{DynamicResource Bg3}"
                            BorderBrush="{DynamicResource Bd}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="9,3"
                            Margin="6,0,0,0">
                        <TextBlock Text="{Binding UtcTime}"
                                   Foreground="{DynamicResource T2}"
                                   FontSize="10"/>
                    </Border>
                    <Border Background="{DynamicResource Bg3}"
                            BorderBrush="{DynamicResource Bd}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="9,3"
                            Margin="6,0,0,0">
                        <TextBlock Text="{Binding TodayDate}"
                                   Foreground="{DynamicResource T2}"
                                   FontSize="10"/>
                    </Border>
                </StackPanel>

                <!-- ── Theme toggle group ──
                     NOTE: Use RadioButton with ToggleButton style, or
                     handle IsChecked in code-behind on click -->
                <Border Grid.Column="4"
                        Background="{DynamicResource Bg3}"
                        BorderBrush="{DynamicResource Bd}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="2"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="BtnDark"
                                      Content="🌙 Dark"
                                      IsChecked="True"
                                      Click="BtnDark_Click"
                                      Style="{StaticResource S.ToggleBtn}"/>
                        <Rectangle Width="1" Fill="{DynamicResource Bd}" Margin="2,2"/>
                        <ToggleButton x:Name="BtnLight"
                                      Content="☀ Light"
                                      Click="BtnLight_Click"
                                      Style="{StaticResource S.ToggleBtn}"/>
                    </StackPanel>
                </Border>

                <!-- ── Layout toggle group ── -->
                <Border Grid.Column="5"
                        Background="{DynamicResource Bg3}"
                        BorderBrush="{DynamicResource Bd}"
                        BorderThickness="1"
                        CornerRadius="5"
                        Padding="2"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="BtnCompact"
                                      Content="⊞ Compact"
                                      IsChecked="True"
                                      Click="BtnLayout_Click"
                                      Tag="8"
                                      Style="{StaticResource S.ToggleBtn}"/>
                        <Rectangle Width="1" Fill="{DynamicResource Bd}" Margin="2,2"/>
                        <ToggleButton x:Name="BtnMedium"
                                      Content="⊟ Medium"
                                      Click="BtnLayout_Click"
                                      Tag="4"
                                      Style="{StaticResource S.ToggleBtn}"/>
                        <Rectangle Width="1" Fill="{DynamicResource Bd}" Margin="2,2"/>
                        <ToggleButton x:Name="BtnWide"
                                      Content="☰ Wide"
                                      Click="BtnLayout_Click"
                                      Tag="2"
                                      Style="{StaticResource S.ToggleBtn}"/>
                    </StackPanel>
                </Border>

                <!-- MT5 connection indicator -->
                <StackPanel Grid.Column="6"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7"
                             Fill="{DynamicResource ColGreen}"
                             Margin="0,0,5,0"/>
                    <TextBlock Text="MT5 Connected"
                               Foreground="{DynamicResource ColGreen}"
                               FontSize="10"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ════════════════════════════════
             MAIN SCROLLABLE CONTENT
             ════════════════════════════════ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>

                <!-- ══════════ DECISION BAR ══════════ -->
                <Border Background="{DynamicResource Bg1}"
                        BorderBrush="{DynamicResource Bd}"
                        BorderThickness="0,0,0,1"
                        Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>   <!-- Verdict box -->
                            <ColumnDefinition Width="*"/>      <!-- Trade details -->
                            <ColumnDefinition Width="140"/>    <!-- Confidence bar -->
                            <ColumnDefinition Width="Auto"/>   <!-- Action buttons -->
                        </Grid.ColumnDefinitions>

                        <!-- Verdict box — colour driven by ViewModel -->
                        <Border x:Name="VerdictBox"
                                Background="{DynamicResource VerdictGreenBg}"
                                BorderBrush="{DynamicResource VerdictGreenBd}"
                                BorderThickness="1"
                                CornerRadius="5"
                                Padding="14,10"
                                MinWidth="175"
                                VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="DECISION"
                                           Foreground="{DynamicResource ColGreen}"
                                           FontSize="9"
                                           Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding Decision}"
                                           Foreground="{DynamicResource ColGreen}"
                                           FontSize="15"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <!-- Trade detail values -->
                        <Grid Grid.Column="1" Margin="14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="DIRECTION" Style="{StaticResource S.TinyLabel}"/>
                                <TextBlock Text="{Binding Direction}"
                                           Foreground="{DynamicResource ColGreen}"
                                           FontWeight="SemiBold"
                                           FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="ENTRY" Style="{StaticResource S.TinyLabel}"/>
                                <TextBlock Text="{Binding Entry}" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="STOP LOSS" Style="{StaticResource S.TinyLabel}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding StopLoss}" FontSize="12"/>
                                    <TextBlock Text="{Binding SlPips}"
                                               Foreground="{DynamicResource ColRed}"
                                               FontSize="11"
                                               Margin="4,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="TAKE PROFIT" Style="{StaticResource S.TinyLabel}"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding TakeProfit}" FontSize="12"/>
                                    <TextBlock Text="{Binding TpPips}"
                                               Foreground="{DynamicResource ColGreen}"
                                               FontSize="11"
                                               Margin="4,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="R : R" Style="{StaticResource S.TinyLabel}"/>
                                <TextBlock Text="{Binding RiskReward}"
                                           Foreground="{DynamicResource ColGreen}"
                                           FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="5">
                                <TextBlock Text="LOT SIZE" Style="{StaticResource S.TinyLabel}"/>
                                <TextBlock Text="{Binding LotSize}" FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="6">
                                <TextBlock Text="RISK $" Style="{StaticResource S.TinyLabel}"/>
                                <TextBlock Text="{Binding RiskDollar}"
                                           Foreground="{DynamicResource ColGreen}"
                                           FontSize="12"/>
                            </StackPanel>
                            <StackPanel Grid.Column="7">
                                <TextBlock Text="MAX PROFIT" Style="{StaticResource S.TinyLabel}"/>
                                <TextBlock Text="{Binding MaxProfit}"
                                           Foreground="{DynamicResource ColGreen}"
                                           FontSize="12"/>
                            </StackPanel>
                        </Grid>

                        <!-- Confidence bar -->
                        <StackPanel Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Margin="0,0,12,0">
                            <TextBlock Text="CONFIDENCE"
                                       Style="{StaticResource S.TinyLabel}"
                                       Margin="0,0,0,3"/>
                            <ProgressBar Value="{Binding Confidence}"
                                         Maximum="100"
                                         Foreground="{Binding ConfidencePct, Converter={StaticResource PercentageToBrushConverter}}"
                                         Style="{StaticResource S.ConfBar}"/>
                            <TextBlock Text="{Binding ConfidencePct}"
                                       Foreground="{Binding ConfidencePct, Converter={StaticResource PercentageToBrushConverter}}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Margin="0,2,0,0"/>
                        </StackPanel>

                        <!-- Action buttons -->
                        <StackPanel Grid.Column="3"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Button Content="▲ BUY"
                                    Command="{Binding TradeCommand}"
                                    CommandParameter="BUY"
                                    Style="{StaticResource S.ActionBtn}"
                                    Foreground="{DynamicResource ColGreen}"
                                    Background="{DynamicResource VerdictGreenBg}"
                                    BorderBrush="{DynamicResource VerdictGreenBd}"/>
                            <Button Content="▼ SELL"
                                    Command="{Binding TradeCommand}"
                                    CommandParameter="SELL"
                                    Style="{StaticResource S.ActionBtn}"
                                    Foreground="{DynamicResource ColRed}"
                                    Background="{DynamicResource VerdictRedBg}"
                                    BorderBrush="{DynamicResource VerdictRedBd}"
                                    Margin="6,0,0,0"/>
                            <Button Content="SKIP"
                                    Command="{Binding TradeCommand}"
                                    CommandParameter="SKIP"
                                    Style="{StaticResource S.ActionBtn}"
                                    Margin="6,0,0,0"/>
                            <Button Content="↺"
                                    Command="{Binding ResetCommand}"
                                    Style="{StaticResource S.FlatBtn}"
                                    Padding="10,6"
                                    Margin="6,0,0,0"
                                    ToolTip="Reset detail panel"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══════════ TILE GRID ══════════
                     TileColumns bound from ViewModel (int: 8 | 4 | 2)
                     ItemsControl + UniformGrid is the correct WPF pattern
                     for a dynamic column count.
                     ====================================== -->
                <ItemsControl x:Name="TilesControl"
                              ItemsSource="{Binding Sections}"
                              Margin="8,8,8,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!--  UniformGrid.Columns is NOT a DP — set it
                                  from code-behind after layout toggle.     -->
                            <UniformGrid x:Name="TilesPanel"
                                         Columns="8"
                                         HorizontalAlignment="Stretch"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Each tile is a Button with a custom template
                                 so hover / press states are preserved.      -->
                            <Button Margin="4"
                                    Command="{Binding DataContext.SelectSectionCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"
                                    Cursor="Hand"
                                    Padding="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="TileBorder"
                                                Background="{DynamicResource Bg1}"
                                                BorderBrush="{DynamicResource Bd}"
                                                BorderThickness="0,0,0,2"
                                                CornerRadius="6"
                                                SnapsToDevicePixels="True"
                                                MinHeight="220">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="TileBorder"
                                                        Property="Background"
                                                        Value="{DynamicResource Bg2}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>

                                <Grid Margin="10,10,10,8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>  <!-- Title + dot -->
                                        <RowDefinition Height="Auto"/>  <!-- Status badge -->
                                        <RowDefinition Height="*"/>     <!-- Row list -->
                                        <RowDefinition Height="Auto"/>  <!-- Footer -->
                                    </Grid.RowDefinitions>

                                    <!-- Title row -->
                                    <Grid Grid.Row="0" Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Icon}"
                                                   Foreground="{Binding Percentage, Converter={StaticResource PercentageToBrushConverter}}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,6,0"
                                                   VerticalAlignment="Top"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DisplayTitle}"
                                                   Foreground="{DynamicResource T1}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Top"/>
                                        <!-- Status dot -->
                                        <Ellipse Grid.Column="2"
                                                 Width="8" Height="8"
                                                 VerticalAlignment="Top"
                                                 Margin="8,3,0,0">
                                            <Ellipse.Fill>
                                                <Binding Path="Percentage" Converter="{StaticResource PercentageToBrushConverter}"/>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                    </Grid>

                                    <!-- Status badge -->
                                    <Border Grid.Row="1"
                                            HorizontalAlignment="Left"
                                            CornerRadius="4"
                                            Padding="7,3"
                                            Margin="0,0,0,8"
                                            BorderBrush="{Binding Percentage, Converter={StaticResource PercentageToBrushConverter}}"
                                            BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Bg3}"/>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}"
                                                   Foreground="{Binding Percentage, Converter={StaticResource PercentageToBrushConverter}}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"/>
                                    </Border>
                                    <ProgressBar Grid.Row="1"
                                                 Value="{Binding Percentage, Converter={StaticResource PercentageToValueConverter}}"
                                                 Maximum="100"
                                                 Foreground="{Binding Percentage, Converter={StaticResource PercentageToBrushConverter}}"
                                                 Style="{StaticResource S.ConfBar}"
                                                 Margin="0,26,0,8"/>

                                    <!-- Summary row list -->
                                    <ItemsControl Grid.Row="2"
                                                  ItemsSource="{Binding Summary}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource Bd}"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="0,3">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="38"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Label}"
                                                                   Foreground="{Binding Percentage, Converter={StaticResource PercentageToBrushConverter}}"
                                                                   FontSize="9"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Value}"
                                                                   Foreground="{Binding Percentage, Converter={StaticResource PercentageToBrushConverter}}"
                                                                   FontSize="9"
                                                                   FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   Margin="4,0,0,0"
                                                                   MinWidth="44"
                                                                   TextAlignment="Right"/>
                                                        <ProgressBar Grid.Column="2"
                                                                     Value="{Binding Percentage, Converter={StaticResource PercentageToValueConverter}}"
                                                                     Maximum="100"
                                                                     Foreground="{Binding Percentage, Converter={StaticResource PercentageToBrushConverter}}"
                                                                     Style="{StaticResource S.ConfBar}"
                                                                     Height="4"
                                                                     Margin="5,0,0,0"
                                                                     VerticalAlignment="Center"/>
                                                        <!-- Source tag -->
                                                        <Border Grid.Column="3"
                                                                CornerRadius="2"
                                                                Padding="3,1"
                                                                Margin="4,0,0,0"
                                                                VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource TagAutoBg}"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource TagAutoBd}"/>
                                                                    <Setter Property="BorderThickness" Value="1"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Source}" Value="SEMI">
                                                                            <Setter Property="Background" Value="{DynamicResource TagSemiBg}"/>
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource TagSemiBd}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Source}" Value="API">
                                                                            <Setter Property="Background" Value="{DynamicResource TagApiBg}"/>
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource TagApiBd}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Source}" Value="MAN">
                                                                            <Setter Property="Background" Value="{DynamicResource TagManBg}"/>
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource TagManBd}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Source}" Value="CFG">
                                                                            <Setter Property="Background" Value="{DynamicResource TagCfgBg}"/>
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource TagCfgBd}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Source}" Value="SEL">
                                                                            <Setter Property="Background" Value="{DynamicResource TagManBg}"/>
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource TagManBd}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding Source}"
                                                                       Foreground="{Binding Source, Converter={StaticResource SourceToBrushConverter}}"
                                                                       FontSize="8"
                                                                       FontWeight="SemiBold"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Footer tap hint -->
                                    <TextBlock Grid.Row="3"
                                               Text="tap for full detail →"
                                               Foreground="{DynamicResource T4}"
                                               FontSize="9"
                                               HorizontalAlignment="Right"
                                               Margin="0,7,0,0"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ══════════ DETAIL PANEL ══════════
                     Visible only when a section is selected.
                     Visibility toggled from code-behind / converter.
                     ====================================== -->
                <Border x:Name="DetailPanel"
                        Background="{DynamicResource Bg2}"
                        BorderBrush="{DynamicResource Bd}"
                        BorderThickness="0,1,0,1"
                        Padding="12,10"
                        Margin="8,6,8,0"
                        Visibility="{Binding SelectedSection, Converter={StaticResource NullToVisibilityConverter}}">
                    <StackPanel>

                        <!-- Detail header -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="TbDetailTitle"
                                           Text="{Binding SelectedSection.Title}"
                                           Foreground="{DynamicResource T1}"
                                           FontWeight="SemiBold"
                                           FontSize="12"/>
                                <TextBlock Text="Full rule evidence and calculation source"
                                           Foreground="{DynamicResource T4}"
                                           FontSize="9"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <!-- Legend tags -->
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Border Background="{DynamicResource TagAutoBg}" BorderBrush="{DynamicResource TagAutoBd}" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,5,0">
                                    <TextBlock Text="AUTO  MT5 calculated" Foreground="{DynamicResource TagAutoFg}" FontSize="9" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="{DynamicResource TagSemiBg}" BorderBrush="{DynamicResource TagSemiBd}" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,5,0">
                                    <TextBlock Text="SEMI  rule-based estimate" Foreground="{DynamicResource TagSemiFg}" FontSize="9" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="{DynamicResource TagApiBg}" BorderBrush="{DynamicResource TagApiBd}" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,5,0">
                                    <TextBlock Text="API  external feed" Foreground="{DynamicResource TagApiFg}" FontSize="9" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="{DynamicResource TagManBg}" BorderBrush="{DynamicResource TagManBd}" BorderThickness="1" CornerRadius="3" Padding="6,2" Margin="0,0,5,0">
                                    <TextBlock Text="MAN  manual input" Foreground="{DynamicResource TagManFg}" FontSize="9" FontWeight="SemiBold"/>
                                </Border>
                                <Border Background="{DynamicResource TagCfgBg}" BorderBrush="{DynamicResource TagCfgBd}" BorderThickness="1" CornerRadius="3" Padding="6,2">
                                    <TextBlock Text="CFG  user config" Foreground="{DynamicResource TagCfgFg}" FontSize="9" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- Detail table -->
                        <Border Background="{DynamicResource Bg1}"
                                BorderBrush="{DynamicResource Bd}"
                                BorderThickness="1"
                                CornerRadius="5"
                                ClipToBounds="True">
                            <StackPanel>
                                <!-- Column headers -->
                                <Grid Background="{DynamicResource Bg3}"
                                      MinHeight="30">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1.5*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="3*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="CHECK"  Style="{StaticResource S.TinyLabel}" Margin="10,8" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="VALUE"  Style="{StaticResource S.TinyLabel}" Margin="10,8" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="PCT"    Style="{StaticResource S.TinyLabel}" Margin="10,8" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="SOURCE" Style="{StaticResource S.TinyLabel}" Margin="10,8" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="NOTE"   Style="{StaticResource S.TinyLabel}" Margin="10,8" VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Scrollable detail rows -->
                                <ScrollViewer MaxHeight="320"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding SelectedSection.Details}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource Bd}"
                                                        BorderThickness="0,0,0,1"
                                                        MinHeight="32">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="2*"/>
                                                            <ColumnDefinition Width="1.5*"/>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="3*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Label}"
                                                                   Foreground="{Binding Percentage, Converter={StaticResource PercentageToBrushConverter}}"
                                                                   FontSize="11"
                                                                   Margin="10,6"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Value}"
                                                                   Foreground="{Binding Percentage, Converter={StaticResource PercentageToBrushConverter}}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Margin="10,6"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                        <StackPanel Grid.Column="2"
                                                                    Margin="10,6"
                                                                    VerticalAlignment="Center">
                                                            <ProgressBar Value="{Binding Percentage, Converter={StaticResource PercentageToValueConverter}}"
                                                                         Maximum="100"
                                                                         Foreground="{Binding Percentage, Converter={StaticResource PercentageToBrushConverter}}"
                                                                         Style="{StaticResource S.ConfBar}"/>
                                                            <TextBlock Text="{Binding Percentage}"
                                                                       Foreground="{Binding Percentage, Converter={StaticResource PercentageToBrushConverter}}"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Right"
                                                                       Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                        <Border Grid.Column="3"
                                                                CornerRadius="3"
                                                                BorderThickness="1"
                                                                Padding="5,2"
                                                                Margin="10,6"
                                                                HorizontalAlignment="Left"
                                                                VerticalAlignment="Center">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="{DynamicResource TagAutoBg}"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource TagAutoBd}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Source}" Value="SEMI">
                                                                            <Setter Property="Background" Value="{DynamicResource TagSemiBg}"/>
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource TagSemiBd}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Source}" Value="API">
                                                                            <Setter Property="Background" Value="{DynamicResource TagApiBg}"/>
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource TagApiBd}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Source}" Value="MAN">
                                                                            <Setter Property="Background" Value="{DynamicResource TagManBg}"/>
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource TagManBd}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Source}" Value="CFG">
                                                                            <Setter Property="Background" Value="{DynamicResource TagCfgBg}"/>
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource TagCfgBd}"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Source}" Value="SEL">
                                                                            <Setter Property="Background" Value="{DynamicResource TagManBg}"/>
                                                                            <Setter Property="BorderBrush" Value="{DynamicResource TagManBd}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding Source}"
                                                                       FontSize="9"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{Binding Source, Converter={StaticResource SourceToBrushConverter}}"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="4"
                                                                   Text="{Binding Note}"
                                                                   Foreground="{DynamicResource T4}"
                                                                   FontSize="11"
                                                                   Margin="10,6"
                                                                   VerticalAlignment="Center"
                                                                   TextTrimming="CharacterEllipsis"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ══════════ MANUAL INPUTS ══════════ -->
                <Border Background="{DynamicResource Bg1}"
                        BorderBrush="{DynamicResource Bd}"
                        BorderThickness="0,1,0,1"
                        Padding="12,10"
                        Margin="8,6,8,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="MANUAL INPUTS"
                                       Style="{StaticResource S.SectionTitle}"
                                       Margin="0,0,10,0"
                                       VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource Bg3}"
                                    BorderBrush="{DynamicResource Bd}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="8,2">
                                <TextBlock Text="4 sentiment dropdowns + 3 optional overrides — everything else is automatic"
                                           Foreground="{DynamicResource T3}"
                                           FontSize="9"
                                           VerticalAlignment="Center"/>
                            </Border>
                        </StackPanel>

                        <!-- Sentiment section label -->
                        <TextBlock Text="SENTIMENT  —  external sources, manual fallback"
                                   Style="{StaticResource S.TinyLabel}"
                                   Margin="0,0,0,5"/>

                        <UniformGrid Columns="7" Margin="0,0,0,0">
                            <!-- Sentiment dropdowns -->
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Risk Mood" Style="{StaticResource S.TinyLabel}"/>
                                <ComboBox SelectedIndex="1">
                                    <ComboBoxItem>Risk-On</ComboBoxItem>
                                    <ComboBoxItem>Neutral</ComboBoxItem>
                                    <ComboBoxItem>Risk-Off</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="ECB / EUR Tone" Style="{StaticResource S.TinyLabel}"/>
                                <ComboBox SelectedIndex="0">
                                    <ComboBoxItem>Hawkish</ComboBoxItem>
                                    <ComboBoxItem>Neutral</ComboBoxItem>
                                    <ComboBoxItem>Dovish</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Fed / USD Tone" Style="{StaticResource S.TinyLabel}"/>
                                <ComboBox SelectedIndex="0">
                                    <ComboBoxItem>Hawkish</ComboBoxItem>
                                    <ComboBoxItem>Neutral</ComboBoxItem>
                                    <ComboBoxItem>Dovish</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Geopolitical Risk" Style="{StaticResource S.TinyLabel}"/>
                                <ComboBox SelectedIndex="0">
                                    <ComboBoxItem>Low</ComboBoxItem>
                                    <ComboBoxItem>Medium</ComboBoxItem>
                                    <ComboBoxItem>High</ComboBoxItem>
                                </ComboBox>
                            </StackPanel>
                            <!-- Override inputs -->
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Entry override" Style="{StaticResource S.TinyLabel}"/>
                                <TextBox Text="{Binding EntryOverride, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Leave blank to use auto: 1.08530"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="SL override" Style="{StaticResource S.TinyLabel}"/>
                                <TextBox Text="{Binding SlOverride, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Leave blank to use auto: 1.08380"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="TP override" Style="{StaticResource S.TinyLabel}"/>
                                <TextBox Text="{Binding TpOverride, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Leave blank to use auto: 1.08830"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- ══════════ TRADE LOG ══════════ -->
                <Border Background="{DynamicResource Bg0}"
                        Padding="12,10"
                        Margin="8,6,8,8">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="TRADE LOG"
                                       Style="{StaticResource S.SectionTitle}"/>
                            <TextBlock Text="{Binding TradeLogSummary}"
                                       Foreground="{DynamicResource T4}"
                                       FontSize="10"
                                       HorizontalAlignment="Right"/>
                        </Grid>

                        <DataGrid ItemsSource="{Binding TradeLogs}"
                                  AutoGenerateColumns="False"
                                  HeadersVisibility="Column"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Time"    Binding="{Binding Time}"      Width="55"/>
                                <DataGridTextColumn Header="Pair"    Binding="{Binding Pair}"      Width="90"/>
                                <DataGridTextColumn Header="Dir"     Binding="{Binding Direction}" Width="50"/>
                                <DataGridTextColumn Header="Entry"   Binding="{Binding Entry}"     Width="80"/>
                                <DataGridTextColumn Header="SL"      Binding="{Binding StopLoss}"  Width="60"/>
                                <DataGridTextColumn Header="TP"      Binding="{Binding TakeProfit}" Width="60"/>
                                <DataGridTextColumn Header="R:R"     Binding="{Binding RiskReward}" Width="50"/>
                                <DataGridTextColumn Header="Lot"     Binding="{Binding Lot}"       Width="50"/>
                                <DataGridTextColumn Header="Result"  Binding="{Binding Result}"    Width="70"/>
                                <DataGridTextColumn Header="Pips"    Binding="{Binding Pips}"      Width="55"/>
                                <DataGridTextColumn Header="Notes"   Binding="{Binding Notes}"     Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
